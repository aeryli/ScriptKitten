{
  "manifest_version": 3,
  "name": "Scriptkitten",
  "version": "2025.8.31",
  "description": "Adds a custom addon manager to Penguinmod, Turbowarp, and a few other mods",
  "icons": { "96": "assets/favicon.ico", "128": "assets/favicon_128x128.png", "16": "assets/favicon_16x16.png", "32": "assets/favicon_32x32.png", "48": "assets/favicon_48x48.png" },
  
  "action": { "default_popup": "code/popup.html" },
  "permissions": ["scripting", "activeTab", "userScripts"],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self';" },

  "background": { "service_worker": "docs/manager.js" },
  "content_scripts": [{
      "matches": ["https://studio.penguinmod.com/*", "https://mirror.turbowarp.xyz/*", "https://turbowarp.org/*", "https://dinosaurmod.github.io/*", "https://snail-ide.js.org/*", "https://librekitten.org/*", "https://alpha.unsandboxed.org/*", "https://ampmod.codeberg.page/*", "https://espressoblocks.com/*"],
      "js": ["docs/manager.user.js"],
      "run_at": "document_idle"
  }]
}
